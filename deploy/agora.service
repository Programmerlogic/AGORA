[Unit]
Description=AGORA Fraud Monitoring Dashboard
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/ubuntu/agora
ExecStart=/usr/bin/docker compose -f deploy/docker-compose.yml up -d --build
ExecStop=/usr/bin/docker compose -f deploy/docker-compose.yml down
User=ubuntu
Group=docker

[Install]
WantedBy=multi-user.target
